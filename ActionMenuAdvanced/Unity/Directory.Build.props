<Project>
    <!--
        Unity tools for AdvActionMenu (generator for icons and override JSON).
        Built against the DLLs of your Unity installation. Change the path here
        or set it with the environment variable UNITY_MANAGED.
    -->
    <PropertyGroup>
        <UnityManaged Condition="'$(UnityManaged)' == '' and '$(UNITY_MANAGED)' != ''">$(UNITY_MANAGED)</UnityManaged>
        <UnityManaged Condition="'$(UnityManaged)' == ''">D:\Unity\Versions\2022.3.58f1\Editor\Data\Managed</UnityManaged>
        <!-- built DLLs go to Editor\AdvActionMenu in the project folder (drag that folder into Assets as it is) -->
        <UnityOut>$(MSBuildThisFileDirectory)..\Editor\AdvActionMenu\</UnityOut>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <Version>1.0.0</Version>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <Target Name="CheckUnityPath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll')"
               Text="Unity not found at '$(UnityManaged)'. Change the path in Unity\Directory.Build.props or set the environment variable UNITY_MANAGED." />
    </Target>
</Project>
